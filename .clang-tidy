# Used by `make tidy`. Real bug classes only; style checks that fire on every line of numeric/SIMD code are off.
Checks: >
  -*,clang-analyzer-*,bugprone-*,cert-*,performance-*,portability-*,
  -bugprone-easily-swappable-parameters,-bugprone-narrowing-conversions,-bugprone-reserved-identifier,
  -bugprone-implicit-widening-of-multiplication-result,-bugprone-assignment-in-if-condition,
  -bugprone-macro-parentheses,-bugprone-signed-bitwise,-bugprone-unchecked-string-to-number-conversion,
  -cert-err33-c,-cert-err34-c,-cert-dcl37-c,
  -clang-analyzer-optin.performance.Padding,-clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling
# do not report on the vendored stb headers
HeaderFilterRegex: '^$'
